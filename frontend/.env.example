# Base URL of the FastAPI backend. This is the ONLY configuration this
# frontend needs — no LLM provider key belongs here, ever. Every OpenAI
# call happens server-side inside agents/*.py, using the backend's own
# OPENAI_API_KEY (see the backend's own .env, not this one).
VITE_API_BASE_URL=http://127.0.0.1:8000
